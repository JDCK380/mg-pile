<!-- MG 私桩 · 主页（移植自 web/template.html 1.0.0） -->
<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">MG 私桩 · 小程序 1.0.0</view>
      <view class="title">我的充电桩</view>
      <view class="sub">蓝牙连接 · 随时掌握充电状态</view>
    </view>
    <view class="badge {{connected ? 'on' : ''}}">{{connectionText}}</view>
  </view>
  <view class="note">本地蓝牙连接，不登录 MG 账号、不上传 VIN。</view>

  <view wx:if="{{isDevtools}}" class="card demo">
    <view class="check">
      <text>开发者工具模拟充电桩（不连接真实蓝牙，结果不代表实桩）</text>
      <switch checked="{{demo}}" disabled="{{connected || busy}}" color="#3482ff" bindchange="onDemo" />
    </view>
  </view>

  <!-- 充电状态 -->
  <view class="card">
    <view class="h2">充电状态</view>
    <view class="metrics">
      <view class="metric primary-metric"><text class="small">充电状态</text><text class="strong">{{statusText}}</text></view>
      <view class="metric"><text class="small">车辆认证</text><text class="strong">{{authText}}</text></view>
      <view class="metric"><text class="small">灯光 / 音量</text><text class="strong">{{extrasText}}</text></view>
    </view>
    <view class="p dark">{{deviceNameText}}</view>
    <view class="p">{{scheduleText}}</view>
    <view class="p muted">{{lastReadText}}</view>
    <view class="row">
      <button class="btn" disabled="{{!canQuery}}" bindtap="onRead">读取系统信息</button>
      <button class="btn" disabled="{{!canQuery}}" bindtap="onSync">同步时间</button>
    </view>
    <view class="check">
      <text>每 5 秒读取一次状态</text>
      <switch checked="{{polling}}" disabled="{{!connected}}" color="#3482ff" bindchange="onPoll" />
    </view>
  </view>

  <!-- 连接 -->
  <view class="card">
    <view class="h2">连接充电桩</view>
    <view class="label">设备编号 / 桩号</view>
    <input class="input" value="{{form.pile}}" disabled="{{formLocked}}" placeholder="输入完整编号，例如 AY12ARM269A1B2C" bindinput="onPile" />
    <view class="label">与充电桩绑定的车辆 VIN</view>
    <input class="input" value="{{form.vin}}" disabled="{{formLocked}}" maxlength="17" placeholder="17 位 VIN，仅保留在内存中" bindinput="onVin" />
    <view class="check">
      <text>这是我拥有或获准使用的桩；桩请求 VIN 校验时，允许发送上面填写的车辆 VIN。</text>
      <switch checked="{{form.consent}}" disabled="{{formLocked}}" color="#3482ff" bindchange="onConsent" />
    </view>
    <view class="check">
      <text>搜索全部蓝牙设备（默认只显示 AYXXARM269XXXXX）</text>
      <switch checked="{{form.allDevices}}" disabled="{{!canConnect}}" color="#3482ff" bindchange="onAll" />
    </view>
    <view class="row">
      <button class="btn primary" disabled="{{!canConnect}}" bindtap="onDirect">按编号连接</button>
      <button class="btn" disabled="{{!canConnect}}" bindtap="onPick">搜索并选择</button>
      <button class="btn" disabled="{{!canDisconnect}}" bindtap="onDisconnect">断开</button>
    </view>
    <view class="message" wx:if="{{message}}">{{message}}</view>
    <view class="fold" bindtap="toggleHelp">{{showHelp ? '▾' : '▸'}} 连接条件与认证说明</view>
    <view wx:if="{{showHelp}}" class="p">需打开手机蓝牙并授权微信使用蓝牙；安卓手机扫描还需要位置权限和系统定位开关。服务 FFF0，指令 FFF3，VIN FFF6；监听 FFF4 / FFF5 / FFF9。VIN 校验失败会停止发送控制指令。桩号有填写时，系统信息返回的桩号必须匹配。切到后台会断开蓝牙；断开蓝牙不等于停止充电。</view>
  </view>

  <!-- 充电与设备 -->
  <view class="card">
    <view class="h2">充电与设备</view>
    <view class="p">连接后自动读取桩端信息，核对通过即可操作。</view>
    <button class="btn primary big" disabled="{{!canControl}}" data-name="start" bindtap="onAction">开始充电</button>
    <view class="row"><button class="btn" disabled="{{!canControl}}" bindtap="onImmediate">未到预约时间，立即充电</button></view>
    <view class="row"><button class="btn danger" disabled="{{!canControl}}" data-name="stop" bindtap="onAction">停止充电</button></view>
    <view class="p muted">提前充电会关闭桩端预约，之后不会自动恢复。车辆自身的预约需在车端解除。</view>
    <view class="row">
      <button class="btn" disabled="{{!canControl}}" data-name="lightOn" bindtap="onAction">开启灯光</button>
      <button class="btn" disabled="{{!canControl}}" data-name="lightOff" bindtap="onAction">关闭灯光</button>
    </view>
    <view class="label">提示音音量：{{form.volume}}</view>
    <view class="row">
      <slider class="slider" min="0" max="100" step="1" value="{{form.volume}}" activeColor="#3482ff" block-size="22" bindchanging="onVolume" bindchange="onVolume" />
      <button class="btn narrow" disabled="{{!canControl}}" data-name="setVolume" bindtap="onAction">设置音量</button>
    </view>
  </view>

  <!-- 预约 -->
  <view class="card">
    <view class="h2">预约充电</view>
    <view class="p">时间按照桩本地时钟解释；跨午夜行为需现场确认。</view>
    <view class="row">
      <picker class="picker" mode="time" value="{{form.begin}}" bindchange="onBegin">
        <view class="label">开始</view><view class="input">{{form.begin}}</view>
      </picker>
      <picker class="picker" mode="time" value="{{form.end}}" bindchange="onEnd">
        <view class="label">结束</view><view class="input">{{form.end}}</view>
      </picker>
    </view>
    <view class="row">
      <button class="btn" disabled="{{!canControl}}" data-name="reserve" bindtap="onAction">设置预约</button>
      <button class="btn" disabled="{{!canControl}}" data-name="cancelReserve" bindtap="onAction">关闭预约</button>
    </view>
    <view class="p muted">原 App 提示：预约后可能需要重新插枪，到点自动充电。</view>
  </view>

  <view class="card link" bindtap="openLogs">
    <text>通信日志（{{logCount}} 条）</text><text class="arrow">›</text>
  </view>
  <view class="footer">本地蓝牙连接 · 1.0.0</view>
</view>

<!-- 设备选择面板 -->
<view class="backdrop" wx:if="{{scanMode === 'pick'}}" catchtouchmove="noop">
  <view class="sheet">
    <view class="h2">{{scanTitle}}</view>
    <scroll-view scroll-y class="devices">
      <view wx:if="{{!scanList.length}}" class="p muted">靠近自己的充电桩，等待设备出现…</view>
      <view wx:for="{{scanList}}" wx:key="deviceId" class="device" data-id="{{item.deviceId}}" bindtap="onChoose">
        <view>
          <view class="device-name">{{item.name || '未命名设备'}}</view>
          <view class="muted small-text">{{item.deviceId}}</view>
        </view>
        <text class="muted small-text">{{item.rssi}} dBm</text>
      </view>
    </scroll-view>
    <view class="row"><button class="btn" bindtap="onCancelScan">取消</button></view>
  </view>
</view>

<!-- 立即充电确认 -->
<view class="backdrop" wx:if="{{showImmediate}}" catchtouchmove="noop">
  <view class="sheet">
    <view class="h2 big-h2">未到预约时间，立即充电？</view>
    <view class="p">将关闭充电桩的预约，确认关闭后发送启动指令。原预约不会自动恢复；下次需要重新设置。</view>
    <view class="p">如果车辆本身设置了预约，桩端不能代替车辆解除预约；部分桩也可能需要重新插枪。</view>
    <view class="row">
      <button class="btn" bindtap="onCancelImmediate">取消</button>
      <button class="btn primary" bindtap="onConfirmImmediate">关闭预约并启动</button>
    </view>
  </view>
</view>
